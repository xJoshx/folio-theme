{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wada-night/palette.schema.json",
  "title": "Wada Night palette",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "appearance", "settings", "colors"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "appearance": {
      "enum": ["dark", "light"]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["italics"],
      "properties": {
        "italics": {
          "type": "boolean"
        },
        "separatorStyle": {
          "enum": ["soft"]
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rosewater",
        "flamingo",
        "pink",
        "mauve",
        "red",
        "maroon",
        "peach",
        "yellow",
        "green",
        "teal",
        "sky",
        "sapphire",
        "blue",
        "lavender",
        "text",
        "subtext1",
        "subtext0",
        "overlay2",
        "overlay1",
        "overlay0",
        "surface2",
        "surface1",
        "surface0",
        "base",
        "mantle",
        "crust"
      ],
      "properties": {
        "rosewater": { "$ref": "#/$defs/draftColor" },
        "flamingo": { "$ref": "#/$defs/draftColor" },
        "pink": { "$ref": "#/$defs/draftColor" },
        "mauve": { "$ref": "#/$defs/draftColor" },
        "red": { "$ref": "#/$defs/draftColor" },
        "maroon": { "$ref": "#/$defs/draftColor" },
        "peach": { "$ref": "#/$defs/draftColor" },
        "yellow": { "$ref": "#/$defs/draftColor" },
        "green": { "$ref": "#/$defs/draftColor" },
        "teal": { "$ref": "#/$defs/draftColor" },
        "sky": { "$ref": "#/$defs/draftColor" },
        "sapphire": { "$ref": "#/$defs/draftColor" },
        "blue": { "$ref": "#/$defs/draftColor" },
        "lavender": { "$ref": "#/$defs/draftColor" },
        "text": { "$ref": "#/$defs/draftColor" },
        "subtext1": { "$ref": "#/$defs/draftColor" },
        "subtext0": { "$ref": "#/$defs/draftColor" },
        "overlay2": { "$ref": "#/$defs/draftColor" },
        "overlay1": { "$ref": "#/$defs/draftColor" },
        "overlay0": { "$ref": "#/$defs/draftColor" },
        "surface2": { "$ref": "#/$defs/draftColor" },
        "surface1": { "$ref": "#/$defs/draftColor" },
        "surface0": { "$ref": "#/$defs/draftColor" },
        "base": { "$ref": "#/$defs/draftColor" },
        "mantle": { "$ref": "#/$defs/draftColor" },
        "crust": { "$ref": "#/$defs/draftColor" }
      }
    }
  },
  "$defs": {
    "draftColor": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
